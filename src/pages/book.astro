---
import '../styles/pages/book.scss'
import Layout from '../layouts/Layout.astro'

return Astro.redirect('/tracker')
---
<Layout title="Book Online">
    <div class="select normal" aria-label="Agency" onclick="openSelection(this)">
        <select-options>
            <select-option disabled selected>Choose an agency</select-option>
            <select-option data-type="bus">SamTrans</select-option>
            <select-option data-type="train">Caltrain</select-option>
            <select-option data-type="bus">VTA</select-option>
            <select-option data-type="bus">Muni</select-option>
            <select-option data-type="train">BART</select-option>
            <select-option data-type="bus">AC Transit</select-option>
            <select-option data-type="bus">County Connection</select-option>
            <select-option data-type="bus">Tri Delta Transit</select-option>
            <select-option data-type="bus">Golden Gate Transit</select-option>
        </select-options>
    </div>
    <div class="select normal" data-type="fare" data-for="bus" aria-label="Bus fare" onclick="openSelection(this)" hidden>
        <select-options>
            <select-option disabled selected>Choose an fare</select-option>
            <select-option>Student Fare: $1.50</select-option>
            <select-option>Regular Fare: $2.50</select-option>
        </select-options>
    </div>
    <div class="select normal" data-type="fare" data-for="train" aria-label="Train fare" onclick="openSelection(this)" hidden>
        <select-options>
            <select-option disabled selected>Choose an fare</select-option>
            <select-option>Student Fare: $5.00</select-option>
            <select-option>Regular Fare: $7.50</select-option>
        </select-options>
    </div>
</Layout>