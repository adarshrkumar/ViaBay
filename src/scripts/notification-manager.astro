<script>
    import type { StoredNotification } from '../types/notification'

    var notificationsKey = 'notifications'

    // Keys of stored notifications, oldest first. Missing or corrupt data reads as an empty list.
    function getNotificationKeys(): string[] {
        try {
            var parsed: string[] = JSON.parse(localStorage.getItem(notificationsKey) ?? '[]')
            return Array.isArray(parsed)
                ? parsed.filter(k => typeof k === 'string').map(k =>
                    !k.startsWith('NOTIFICATIONS://') && k.includes('|') ? `NOTIFICATIONS://${k}` : k
                )
                : []
        } catch {
            return []
        }
    }
    window.getNotificationKeys = getNotificationKeys

    function getNotificationStorageKey(module: string, name: string) {
        return `NOTIFICATIONS://${module}|${name}`
    }

    function addNotification(module: string, name: string, icon: string, content: string, attachmentInfo?: string) {
        var notification: StoredNotification = { module, name, icon, content }
        if (attachmentInfo) notification.attachmentInfo = attachmentInfo

        var storageKey = getNotificationStorageKey(module, name)
        localStorage.setItem(storageKey, JSON.stringify(notification))

        var keys = getNotificationKeys()
        if (!keys.includes(storageKey)) keys.push(storageKey)
        localStorage.setItem(notificationsKey, JSON.stringify(keys))
    }
    window.addNotification = addNotification
</script>
