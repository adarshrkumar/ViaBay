<script>
    import type { StoredNotification } from '../types/notification'

    var nGroup = document.querySelector('.notifications')
    var defaultIcon = 'notification'

    function readNotification(storageKey: string): StoredNotification | null {
        try {
            var parsed = JSON.parse(localStorage.getItem(storageKey) ?? 'null')
            if (
                parsed && typeof parsed.name === 'string' &&
                (parsed.icon == null || typeof parsed.icon === 'string')
            ) return parsed
        } catch {
            // Fall through and treat corrupt entries as missing
        }
        return null
    }

    window.getNotifications = function () {
        window.getNotificationKeys().forEach(storageKey => {
            if (!storageKey.startsWith('NOTIFICATIONS://')) return
            var notification = readNotification(storageKey)
            if (notification) renderNotification(notification)
            localStorage.removeItem(storageKey)
        })

        localStorage.setItem('notifications', '[]')
    }

    function renderNotification(notification: StoredNotification) {
        var nTitle = notification.name
        var nContent = notification.content

        var nEle = document.createElement('div')
        nEle.classList.add('item')

        var nEleIcon = document.createElement('img')
        nEleIcon.classList.add('icon')
        nEleIcon.alt = ''
        nEleIcon.src = `/icons/${encodeURIComponent(notification.icon || defaultIcon)}.svg`
        nEleIcon.addEventListener('error', () => nEleIcon.src = `/icons/${defaultIcon}.svg`, { once: true })
        nEle.appendChild(nEleIcon)

        var nEleContent = document.createElement('item-content')
        nEleContent.textContent = nTitle
        nEle.appendChild(nEleContent)

        nGroup?.appendChild(nEle)

        nEle.addEventListener('click', () => {
            if (nContent) window.showModal(nTitle, nContent)
        })
    }

    window.getNotifications()
</script>
