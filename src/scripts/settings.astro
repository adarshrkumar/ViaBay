<script>
    // Apply settings once, after the <setting-option> nodes exist
    window.addEventListener('DOMContentLoaded', _e => {
        settings.forEach(setting => {
            if (Object.hasOwn(settingFunctions, setting.name)) settingFunctions[setting.name](setting.content)
        })

        if (location.pathname.startsWith('/settings')) {
            document.querySelectorAll('setting-option').forEach(s => {
                const sel = s.querySelector('select')
                const name = s.getAttribute('module-name')
                if (!sel || !name) return

                var setting = settings.find(setting => setting.name === name)?.content
                if (typeof setting === 'string') sel.value = setting
                sel.addEventListener('change', () => setSetting(name, sel.value))
            })
        }
    })

    function setTheme(t: string) {
        document.documentElement.setAttribute('data-theme', (t || 'system'))
    }
    var settingsKey = 'settings'

    type Setting = { name: string; content?: string | string[] | { [key: string]: string } }
    type SettingFunctions = { [key: string]: (value?: string | string[] | { [key: string]: string }) => void }

    var settingFunctions: SettingFunctions = {
        theme: (theme?: string | string[] | { [key: string]: string }) => setTheme(typeof theme === 'string' ? theme : 'system')
    }

    // Missing or corrupt data reads as no settings, and malformed entries are dropped
    var settings: Setting[] = []
    try {
        var parsed: (Setting | null)[] = JSON.parse(localStorage.getItem(settingsKey) || '[]')
        if (Array.isArray(parsed)) settings = parsed.filter((s): s is Setting => typeof s === 'object' && s !== null && typeof s.name === 'string')
    } catch {
        // Keep the empty default
    }

    function setSetting(name: string, value: string, type?: string, key?: string) {
        var index = settings.findIndex(s => s.name === name)

        if (index < 0) {
            settings.push({name: name})
            index = settings.length - 1
        }

        var setting = settings[index]
        var content: string | string[] | { [key: string]: string } | undefined = setting.content
        if (!content) {
            switch(type) {
                case 'object':
                    content = {}
                    break
                case 'list':
                    content = []
                    break
                default:
                    content = ''
                    break
            }
        }

        switch(type) {
            case 'object':
                if (key !== undefined && typeof content === 'object' && !Array.isArray(content)) content[key] = value
                break
            case 'list':
                if (Array.isArray(content)) content.push(value)
                break
            default:
                content = value
                break
        }

        setting.content = content
        settings[index] = setting
        localStorage.setItem(settingsKey, JSON.stringify(settings))

        if (Object.hasOwn(settingFunctions, setting.name)) settingFunctions[setting.name](setting.content)
    }
</script>
